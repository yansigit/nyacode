[codespell]
# Ref: https://github.com/codespell-project/codespell#using-a-config-file
# Integration patches contain untouched upstream context and Git binary data.
# The two dependency crates retain canonical upstream text and test vectors.
skip = */integration/codex/patches/*,integration/codex/patches/*,.git*,vendor,*-lock.yaml,*.lock,.codespellrc,*test.ts,*.jsonl,frame*.txt,*.snap,*.snap.new,third_party/rust/aws-config/*,*/third_party/rust/aws-config/*,third_party/rust/aws-sigv4/*,*/third_party/rust/aws-sigv4/*
check-hidden = true
ignore-regex = ^\s*"image/\S+": ".*|\b(afterAll)\b
ignore-words-list = ratatui,ser,iTerm,iterm2,iterm,te,TE,PASE,SEH

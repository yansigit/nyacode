+def msvc_paths_relative_test(name):
+    flags = [
+        "/imsvctest/sdk",
+        "/imsvc",
+        "test/runtime",
+        "/external:Itest/external",
+        "/clang:-ivfsoverlay",
+        "/clang:test/overlay.yaml",
+        "/clang:-internal-isystem",
+        "/clang:test/clang",
+        "/clang:-fms-compatibility-version=19.50.35717",
+        "/MT",
+    ]
+    expected = [
+        "/imsvc${pwd}/test/sdk",
+        "/imsvc",
+        "${pwd}/test/runtime",
+        "/external:I${pwd}/test/external",
+        "/clang:-ivfsoverlay",
+        "/clang:${pwd}/test/overlay.yaml",
+        "/clang:-internal-isystem",
+        "/clang:${pwd}/test/clang",
+        "/clang:-fms-compatibility-version=19.50.35717",
+        "/MT",
+    ]
+    cargo_build_script_with_extra_cc_compile_flags(
+        name = "%s/cargo_build_script" % name,
+        extra_cc_compile_flags = flags,
+        extra_cxx_compile_flags = ["/clang:-std=c++17"],
+    )
+    cc_args_and_env_analysis_test(
+        name = name,
+        target_under_test = "%s/cargo_build_script" % name,
+        expected_cflags = expected,
+        expected_cxxflags = expected + ["/clang:-std=c++17"],
+    )
+
+def msvc_paths_absolute_test(name):
+    flags = [
+        "/imsvc/test/sdk",
+        "/imsvcC:/test/runtime",
+        "/external:IC:/test/external",
+        "/clang:-ivfsoverlay",
+        "/clang:/test/overlay.yaml",
+        "/clang:-ivfsoverlay",
+        "/clang:C:/test/overlay.yaml",
+        "/clang:-fno-rtti",
+        "/MD",
+    ]
+    expected = [
+        "/imsvc/test/sdk",
+        "/imsvcC:/test/runtime",
+        "/external:IC:/test/external",
+        "/clang:-ivfsoverlay",
+        "/clang:/test/overlay.yaml",
+        "/clang:-ivfsoverlay",
+        "/clang:C:/test/overlay.yaml",
+        "/clang:-fno-rtti",
+        "/MD",
+    ]
+    cargo_build_script_with_extra_cc_compile_flags(
+        name = "%s/cargo_build_script" % name,
+        extra_cc_compile_flags = flags,
+        extra_cxx_compile_flags = ["/clang:-std=c++17"],
+    )
+    cc_args_and_env_analysis_test(
+        name = name,
+        target_under_test = "%s/cargo_build_script" % name,
+        expected_cflags = expected,
+        expected_cxxflags = expected + ["/clang:-std=c++17"],
+    )

+    // MSVC and can accidentally select a host runtime when cross-linking.
+    println!("cargo:rerun-if-env-changed=CODEX_CHAT_CXX_RUNTIME_PROVIDED");
+    if std::env::var_os("CODEX_CHAT_CXX_RUNTIME_PROVIDED").as_deref()

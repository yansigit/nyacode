+#[tokio::test]
+async fn native_sync_post_model_hook_fails_before_inference_or_tool_dispatch() -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    let server = start_mock_server().await;
+    let mut response = ev_completed("native-tool");
+    response["response"]["output"] = json!([{
+        "type": "function_call",
+        "call_id": "native-call",
+        "name": "update_plan",
+        "arguments": "{\"plan\":[{\"step\":\"Unexpected side effect\",\"status\":\"in_progress\"}]}"
+    }]);
+    let requests = mount_sse_once(&server, sse(vec![response])).await;
+    let base_url = server.uri();
+    let test = test_codex()
+        .with_model("gpt-6-luna")
+        .with_pre_build_hook(|home| {
+            write_lifecycle_hooks(home, &["PostModelRequest"]).unwrap();
+            let path = home.join("hooks.json");
+            let mut config: Value = serde_json::from_slice(&fs::read(&path).unwrap()).unwrap();
+            config["hooks"]["PreToolUse"] = json!([{"hooks": [{
+                "type": "command",
+                "command": format!("touch '{}'", home.join("tool-dispatched").display()),
+            }]}]);
+            fs::write(path, config.to_string()).unwrap();
+        })
+        .with_config(move |config| {
+            trust_discovered_hooks(config);
+            config.model_provider_id = "opencode-go".into();
+            config.model_provider = config.model_providers["opencode-go"].clone();
+            config.model_provider.base_url = Some(base_url);
+            config.model_provider.experimental_bearer_token =
+                Some("fixture-token".to_string().into());
+            config.model_catalog = None;
+            config.update_plan_enabled = true;
+            config.features.disable(Feature::Apps).unwrap();
+        })
+        .build_with_auto_env(&server)
+        .await?;
+    test.codex
+        .start_or_steer_turn(TurnInputRequest::user_input(vec![UserInput::Text {
+            text: "Update the plan.".into(),
+            text_elements: vec![],
+        }]))
+        .await?;
+    let error = timeout(
+        Duration::from_secs(10),
+        wait_for_event_match(&test.codex, |event| {
+            if let EventMsg::Error(error) = event {
+                Some(error.clone())
+            } else {
+                None
+            }
+        }),
+    )
+    .await?;
+    assert!(error.message.contains("synchronous PostModelRequest hooks"));
+    timeout(
+        Duration::from_secs(10),
+        wait_for_event(&test.codex, |event| {
+            matches!(event, EventMsg::TurnComplete(_))
+        }),
+    )
+    .await?;
+    let post = wait_for_hook_inputs(test.codex_home_path(), "PostModelRequest", 1).await?;
+    assert_eq!(post.len(), 1);
+    assert_eq!(post[0]["status"], "failed");
+    assert_eq!(post[0]["token_usage"], Value::Null);
+    assert!(
+        post[0]["error"]
+            .as_str()
+            .unwrap()
+            .contains("synchronous PostModelRequest hooks")
+    );
+    assert!(
+        requests.requests().is_empty(),
+        "native inference must not start"
+    );
+    assert!(!test.codex_home_path().join("tool-dispatched").exists());
+    Ok(())
+}
+

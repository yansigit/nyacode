{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "lldb",
      "request": "launch",
      "name": "Nyacode CLI",
      "args": [],
      "preLaunchTask": "Build Nyacode",
      "program": "${workspaceFolder}/.engine/target/debug/nyacode",
      "cwd": "${workspaceFolder}",
      "windows": {
        "program": "${workspaceFolder}/.engine/target/debug/nyacode.exe"
      }
    },
    {
      "type": "lldb",
      "request": "attach",
      "name": "Attach to running codex CLI",
      "pid": "${command:pickProcess}",
      "sourceLanguages": [
        "rust"
      ]
    }
  ]
}

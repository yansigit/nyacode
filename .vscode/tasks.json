{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Build Nyacode",
      "type": "process",
      "command": "python3",
      "windows": {
        "command": "python"
      },
      "args": [
        "${workspaceFolder}/scripts/build_nyacode.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "CARGO_TARGET_DIR": "${workspaceFolder}/.engine/target"
        }
      },
      "problemMatcher": [
        "$rustc"
      ]
    }
  ]
}

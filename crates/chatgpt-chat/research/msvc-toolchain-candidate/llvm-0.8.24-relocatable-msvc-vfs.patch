diff --git a/tools/case_insensitive_vfs/cli_test.sh b/tools/case_insensitive_vfs/cli_test.sh
--- a/tools/case_insensitive_vfs/cli_test.sh
+++ b/tools/case_insensitive_vfs/cli_test.sh
@@ -63,3 +63,27 @@
   echo "depfile contains nonexistent virtual-case header path" >&2
   exit 1
 fi
+
+# Relative SDK paths must survive a different compiler working directory and
+# relocation of the complete tree. Neither overlay embeds the generation cwd.
+case "${VFS_TOOL}" in /*) ;; *) VFS_TOOL="$(pwd)/${VFS_TOOL}" ;; esac
+case "${CLANG}" in /*) ;; *) CLANG="$(pwd)/${CLANG}" ;; esac
+expect_failure 2 "-path-prefix requires a value" "${VFS_TOOL}" -path-prefix
+mkdir -p "${test_tmp}/generated/sub" "${test_tmp}/consumer"
+(
+  cd "${test_tmp}"
+  "${VFS_TOOL}" -root sdk -path-prefix ../.. -output generated/sub/relative.yaml
+)
+(
+  cd "${test_tmp}/consumer"
+  "${CLANG}" -ivfsoverlay ../generated/sub/relative.yaml -I ../sdk \
+    -c ../source.c -o ../relative.o
+)
+mkdir "${test_tmp}/relocated"
+mv "${test_tmp}/sdk" "${test_tmp}/generated" "${test_tmp}/consumer" \
+  "${test_tmp}/source.c" "${test_tmp}/relocated/"
+(
+  cd "${test_tmp}/relocated/consumer"
+  "${CLANG}" -ivfsoverlay ../generated/sub/relative.yaml -I ../sdk \
+    -c ../source.c -o ../relocated.o
+)

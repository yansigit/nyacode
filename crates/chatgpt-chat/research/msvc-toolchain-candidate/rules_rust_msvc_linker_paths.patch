     """
     return ctx.fragments.cpp.linkopts
 
+def msvc_direct_linker_args(args):
+    """Keep declared MSVC library lookup flags when invoking rust-lld directly."""
+    result = []
+    for arg in args:
+        # clang-cl forwards linker options as /clang:-Xlinker /clang:<option>.
+        # rust-lld needs the option itself, without either driver wrapper.
+        if arg.startswith("/clang:"):
+            arg = arg[len("/clang:"):]
+        flag = arg.lower()
+        if flag.startswith(("/libpath:", "-libpath:", "/vfsoverlay:", "-vfsoverlay:")) or flag in ("/lldignoreenv", "-lldignoreenv"):
+            result.append(arg)
+    return result
+
 def get_linker_and_args(ctx, crate_type, toolchain, cc_toolchain, feature_configuration, rpaths, add_flags_for_binary = False):

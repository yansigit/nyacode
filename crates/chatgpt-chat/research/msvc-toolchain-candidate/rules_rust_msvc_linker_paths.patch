diff --git a/test/unit/msvc_linker_args/msvc_linker_args_test.bzl b/test/unit/msvc_linker_args/msvc_linker_args_test.bzl
--- /dev/null
+++ b/test/unit/msvc_linker_args/msvc_linker_args_test.bzl
@@ -0,0 +1,58 @@
+"""Regression fixtures for MSVC library paths exported by a clang-cl toolchain."""
+
+load("@bazel_skylib//lib:unittest.bzl", "asserts", "unittest")
+load("//rust/private:rustc.bzl", "msvc_direct_linker_args")
+
+def _wrapped_sdk_paths_test(ctx):
+    env = unittest.begin(ctx)
+    args = [
+        "/clang:-Xlinker",
+        "/clang:/LIBPATH:bazel-out/msvc runtime",
+        "/clang:-Xlinker",
+        "/clang:/vfsoverlay:bazel-out/sdk.yaml",
+        "/clang:-Xlinker",
+        "/clang:/LIBPATH:external/winsdk/ucrt",
+        "/clang:-Xlinker",
+        "/clang:/LIBPATH:external/winsdk/um",
+        "/clang:-Xlinker",
+        "/clang:/lldignoreenv",
+    ]
+    asserts.equals(env, [
+        "/LIBPATH:bazel-out/msvc runtime",
+        "/vfsoverlay:bazel-out/sdk.yaml",
+        "/LIBPATH:external/winsdk/ucrt",
+        "/LIBPATH:external/winsdk/um",
+        "/lldignoreenv",
+    ], msvc_direct_linker_args(args))
+    return unittest.end(env)
+
+def _direct_paths_preserve_case_and_order_test(ctx):
+    env = unittest.begin(ctx)
+    args = ["/LIBPATH:C:/SDK Libs", "-libpath:external/Runtime", "/VFSOVERLAY:SDK.yaml"]
+    asserts.equals(env, args, msvc_direct_linker_args(args))
+    return unittest.end(env)
+
+def _compiler_and_output_flags_are_not_forwarded_test(ctx):
+    env = unittest.begin(ctx)
+    args = [
+        "--target=x86_64-pc-windows-msvc",
+        "/MT",
+        "/clang:-fms-compatibility-version=19.50.35717",
+        "-L/usr/lib",
+        "--sysroot=/host",
+        "/clang:-Xlinker",
+        "/clang:/OUT:cc-output.exe",
+        "/clang:-Xlinker",
+        "/clang:/MACHINE:ARM64",
+        "/clang:-Xlinker",
+        "/clang:/DEFAULTLIB:msvcrt.lib",
+    ]
+    asserts.equals(env, [], msvc_direct_linker_args(args))
+    return unittest.end(env)
+
+wrapped_sdk_paths_test = unittest.make(_wrapped_sdk_paths_test)
+direct_paths_test = unittest.make(_direct_paths_preserve_case_and_order_test)
+compiler_flags_test = unittest.make(_compiler_and_output_flags_are_not_forwarded_test)
+
+def msvc_linker_args_test_suite(name):
+    unittest.suite(name, wrapped_sdk_paths_test, direct_paths_test, compiler_flags_test)

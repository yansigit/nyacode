diff --git a/.bazelrc b/.bazelrc
--- a/.bazelrc
+++ b/.bazelrc
@@ -14,7 +14,9 @@
 # Match Cargo's MSVC static CRT policy and V8's allocator linkage. Only the
 # MSVC C/C++ toolchain consumes this feature; other toolchains ignore it.
 # Include host dependencies so native build tools use the same runtime.
+build --features=-dynamic_link_msvcrt
 build --features=static_link_msvcrt
+build --host_features=-dynamic_link_msvcrt
 build --host_features=static_link_msvcrt
 
 build --workspace_status_command=./scripts/workspace-status.sh
